# ========================================================
# IsaiStream - Spotify Tamil Edition Environment Variables
# Copy to .env and configure values before starting server
# ========================================================

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# SQL Database Configuration (SQLite local path or Postgres connection string)
SQLITE_DB_PATH=./data/isai_stream.db

# MongoDB Connection String (Atlas or local Mongo)
# If omitted or invalid, automatically runs in resilient local fallback store mode
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/isai_stream?retryWrites=true&w=majority

# Google Gemini AI API Key (Optional: enhances AI Assistant reasoning)
# If omitted or offline, seamlessly utilizes built-in semantic FAQ match and error triage
GEMINI_API_KEY=your_gemini_api_key_here

# Third-Party Music API Timeout Threshold (in milliseconds)
# Strict AbortController threshold before activating offline fallback catalog
THIRD_PARTY_API_TIMEOUT_MS=2500
